# .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# DB 접속 정보 (docker-compose.yml과 application.properties가 함께 읽는다)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=passform
DB_USERNAME=passform
DB_PASSWORD=

# Google 로그인. 값을 넣을 때만 앞의 #을 지운다. 값이 비어 있는 줄이 있으면 앱이 뜨지 않는다.
# 줄이 없으면 앱은 뜨고 로그인만 실패한다.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 로컬 HTTP 개발에서는 false. 비우지 말고, 배포에서는 이 줄을 지운다(기본값 true).
SESSION_COOKIE_SECURE=false
# CORS로 허용하는 프런트 출처. 지우면 http://localhost:5173이다.
FRONTEND_ORIGIN=http://localhost:5173
# 화면과 API의 호스트가 다를 때만 넣는다(예: example.com, 앞에 점 없이).
CSRF_COOKIE_DOMAIN=

# OpenAI 키는 이 파일에 넣지 않는다. OS 환경변수 OPENAI_API_KEY로만 쓴다(AGENTS.md 7절).
# 키가 없어도 빌드와 테스트는 실행된다.

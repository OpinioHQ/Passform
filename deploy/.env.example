# 배포 서버에서 deploy/.env로 복사하고 `chmod 600 .env` 한 뒤 서버에서만 값을 채운다.
# deploy/.env는 .gitignore 대상이다. 값을 저장소, 이슈, PR, 로그, 메신저에 붙이지 않는다.
# 비어 있는 값이 하나라도 있으면 compose가 띄우지 않는다.

DB_NAME=passform
DB_USERNAME=passform
# 서버에서 새로 만든 긴 무작위 값
DB_PASSWORD=change-me

# Google Cloud 콘솔의 OAuth 클라이언트 값
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# 이 프로젝트 전용 OpenAI 키(hard limit을 켠 프로젝트)
OPENAI_API_KEY=change-me

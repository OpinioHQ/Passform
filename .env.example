# .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# DB 접속 정보 (docker-compose.yml과 application.properties가 함께 읽는다)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=passform
DB_USERNAME=passform
DB_PASSWORD=

# Google 로그인. 값을 넣을 때만 앞의 #을 지운다. 값이 비어 있는 줄이 있으면 앱이 뜨지 않는다.
# 줄이 없으면 앱은 뜨고 로그인만 실패한다.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 로컬 HTTP 개발에서는 false. 비우지 말고, 배포에서는 이 줄을 지운다(기본값 true).
SESSION_COOKIE_SECURE=false
# CORS로 허용하는 프런트 출처. 지우면 http://localhost:5173이다.
FRONTEND_ORIGIN=http://localhost:5173
# 화면과 API의 호스트가 다를 때만 넣는다(예: example.com, 앞에 점 없이).
CSRF_COOKIE_DOMAIN=

# 첨부 파일을 시험할 때만 버킷 이름을 넣는다. 없으면 앱은 뜨고 파일 기능만 503이다.
# AWS 자격 증명은 이 파일에 넣지 않는다. OS 환경변수나 서버 역할로만 쓴다.
# S3_BUCKET=
# S3_REGION=ap-northeast-2

# 마감 알림 메일(Gmail SMTP). 메일을 시험할 때만 보내는 Gmail 주소와 그 계정의 앱 비밀번호를 넣는다.
# 둘 중 하나라도 비어 있으면 메일은 보내지 않고 사이트 알림만 만든다. 값은 이 파일 밖에 붙이지 않는다.
MAIL_USERNAME=
MAIL_PASSWORD=
# 보낸 사람 표시(예: Passform <보내는 주소>). 비우면 MAIL_USERNAME이다.
MAIL_FROM=
# 기본값은 smtp.gmail.com, 587이다. 바꿀 때만 앞의 #을 지운다.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# 스케줄러 주기(기본 PT10M)와 알림 구간(기본 24시간). 로컬 확인 때만 바꾼다.
# DEADLINE_REMINDER_INTERVAL=PT1M
# DEADLINE_REMINDER_HOURS=24

# OpenAI 키는 이 파일에 넣지 않는다. OS 환경변수 OPENAI_API_KEY로만 쓴다(AGENTS.md 7절).
# 키가 없어도 빌드와 테스트는 실행된다.

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew build)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew jacocoTestReport)",
      "PowerShell(./gradlew build)",
      "PowerShell(./gradlew test *)",
      "PowerShell(./gradlew jacocoTestReport)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Edit(/tests/harness/**)",
      "Edit(/src/passform/schemas/**)",
      "Edit(/src/response_analysis/schemas/**)",
      "Edit(/src/response_analysis/prompts/**)",
      "Edit(/data/seed/**)",
      "Edit(/evals/evalset.jsonl)",
      "Edit(/config/rag.yaml)",
      "Edit(/tests/java/com/opinio/passform/golden/**)",
      "Edit(/src/main/java/com/opinio/passform/domain/analysis/MatchMode.java)",
      "Edit(/src/main/java/com/opinio/passform/domain/analysis/MatchKind.java)",
      "Edit(/src/main/java/com/opinio/passform/domain/analysis/ResponseStatus.java)",
      "Edit(/src/main/java/com/opinio/passform/domain/analysis/ConditionMatch.java)",
      "Edit(/src/main/java/com/opinio/passform/domain/analysis/ResponseRecord.java)",
      "Edit(/src/main/java/com/opinio/passform/domain/analysis/VersionCoverage.java)",
      "Edit(/src/main/java/com/opinio/passform/domain/analysis/Coverage.java)",
      "Edit(/src/main/java/com/opinio/passform/domain/analysis/EvaluationResult.java)"
    ]
  }
}
